{
  "name": "infitv",
  "version": "0.1.0",
  "private": true,
  "description": "INFI TV - Plataforma IPTV completa (monorepo)",
  "type": "commonjs",
  "packageManager": "npm@11.0.0",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "backend",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify:phase1": "node scripts/check-structure.mjs",
    "verify:phase2": "node scripts/check-phase2.mjs",
    "verify:phase3": "node scripts/check-phase3.mjs",
    "verify:phase4": "node scripts/check-phase4.mjs",
    "verify:phase5": "node scripts/check-phase5.mjs",
    "verify:phase6": "node scripts/check-phase6.mjs",
    "verify:phase7": "node scripts/check-phase7.mjs",
    "verify:phase8": "node scripts/check-phase8.mjs",
    "verify:phase9": "node scripts/check-phase9.mjs",
    "verify:phase10": "node scripts/check-phase10.mjs",
    "verify:phase11": "node scripts/check-phase11.mjs",
    "verify:phase12": "node scripts/check-phase12.mjs",
    "verify:phase13": "node scripts/check-phase13.mjs",
    "verify:phase14": "node scripts/check-phase14.mjs",
    "verify:phase15": "node scripts/check-phase15.mjs",
    "verify:phase16": "node scripts/check-phase16.mjs",
    "verify:phase17": "node scripts/check-phase17.mjs",
    "verify:phase18": "node scripts/check-phase18.mjs",
    "verify:phase19": "node scripts/check-phase19.mjs",
    "verify:phase20": "node scripts/check-phase20.mjs",
    "verify:phase21": "node scripts/check-phase21.mjs",
    "verify:phase22": "node scripts/check-phase22.mjs",
    "verify:phase23": "node scripts/check-phase23.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3"
  }
}
