# INFI TV — .env.example
# Copiar a .env para desarrollo local. NUNCA commitear el .env real.
# Ver docs/architecture.md y README.md

# --- General ---
NODE_ENV=development
API_URL=http://localhost:3000
API_VERSION=v1

# --- Backend ---
PORT=3000
DATABASE_URL=postgresql://infitv:infitv@localhost:5433/infitv?schema=public
TEST_DATABASE_URL=postgresql://infitv:infitv@localhost:5433/infitv_test?schema=public
JWT_SECRET=cambia-este-secreto-en-desarrollo
ADMIN_JWT_SECRET=cambia-este-secreto-admin-en-desarrollo
CODE_PEPPER=cambia-este-pepper-codigos-en-desarrollo
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3001
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Seed dev (FASE 3, nunca en producción) ---
SEED_ADMIN_EMAIL=admin@infitv.local
SEED_ADMIN_PASSWORD=cambia-esta-clave-dev-min-12-chars

# --- Admin web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- IPTV / EPG (fuentes públicas, FASE 8 / FASE 15) ---
IPTV_SOURCE_URL=https://iptv-org.github.io/iptv/index.m3u
EPG_SOURCE_URL=

# --- Redis (opcional, FASE 19) ---
REDIS_URL=redis://localhost:6379

# --- Sync / jobs (FASE 8) ---
IPTV_SYNC_CRON=0 */6 * * *
IPTV_SYNC_ENABLED=false
EPG_SYNC_CRON=0 */6 * * *
EPG_SYNC_ENABLED=false

# --- Seguridad anti-abuso (FASE 18) ---
ABUSE_MAX_FAILURES=10
ABUSE_WINDOW_MS=900000
ABUSE_BLOCK_MS=1800000
